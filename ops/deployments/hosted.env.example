# The hosted deployment's configuration. Copy to `hosted.env` beside this file
# (gitignored) and fill in your host.
#
# THE ONE HOME FOR THIS DEPLOYMENT'S IDENTITY. `just release-*` sources it for
# the SSH host, the image tag and ports, and compose passes it to the
# container, so the values the image is built as and runs under cannot drift
# apart.
#
# No secrets: this deployment has none, and none may be added here.
#
# Consumed as `set -a; . ops/deployments/hosted.env; set +a`.

# The SSH destination `just release-*` acts on: a host name or a ~/.ssh/config alias.
DEPLOY_SSH_HOST=my-server

# The image tag. Bump it for every release so `release-status` and
# `docker image ls` say which build is running.
DEPLOY_RELEASE=2026-01-01.1

# Where the container is published on HOST LOOPBACK, for Tailscale Serve to
# proxy to. Pick a port nothing else on the host uses.
DEPLOY_HOST_PORT=3005

# Tailscale Serve's TLS port, and the origin visitors use.
DEPLOY_SERVE_PORT=8443
DEPLOY_ORIGIN=https://my-server.example.ts.net:8443

# Read-only (ADR-0008): visitors read the curated repos and nothing else.
# Personal, full-feature use is `reposhape up` on your own machine.
REPOSHAPE_READ_ONLY=true

# The names a request may arrive under (api.py refuses any other Host, which
# is what stops DNS rebinding). 127.0.0.1 is the container's own healthcheck;
# the tailnet name is Tailscale Serve's front, whichever Host it forwards.
REPOSHAPE_ALLOWED_HOSTS=127.0.0.1,localhost,my-server.example.ts.net

# Where compose mounts ops/link-rules (ADR-0009).
REPOSHAPE_LINK_RULES_DIR=/etc/reposhape/links
